[Unit]
Description=VULNDB web (gunicorn)
After=network.target postgresql.service redis.service

[Service]
User=vulndb
Group=vulndb
WorkingDirectory=/opt/vulndb
EnvironmentFile=/opt/vulndb/.env
ExecStart=/opt/vulndb/.venv/bin/gunicorn config.wsgi:application --bind 127.0.0.1:8000 --workers 3 --timeout 120
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
