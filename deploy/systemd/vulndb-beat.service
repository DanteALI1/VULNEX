[Unit]
Description=VULNDB Celery beat
After=network.target redis.service vulndb-worker.service

[Service]
User=vulndb
Group=vulndb
WorkingDirectory=/opt/vulndb
EnvironmentFile=/opt/vulndb/.env
ExecStart=/opt/vulndb/.venv/bin/celery -A config beat -l info
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
