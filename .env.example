# VULNDB — пример переменных окружения
# Скопируйте в .env и замените CHANGE_ME_* на свои значения.

DEBUG=1
SECRET_KEY=CHANGE_ME_SECRET_KEY_LONG_RANDOM
ALLOWED_HOSTS=localhost,127.0.0.1,web
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
TIME_ZONE=Europe/Moscow

# PostgreSQL (в Docker Compose создаётся автоматически)
DATABASE_URL=postgresql://vulndb:CHANGE_ME_DB_PASSWORD@db:5432/vulndb
DB_SSLMODE=prefer

# Redis / Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Лицензия
LICENSE_SERVER_URL=http://license_server:8090
LICENSE_FILE=/app/.novalic
LICENSE_GRACE_DAYS=14

# Почта (опционально)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=vulndb@localhost
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1

# Путь к .env для записи мастером настройки (на РЕД ОС)
ENV_FILE_PATH=/app/.env
